{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Sets",
  "scopeName": "source.sets",
  "patterns": [
    {
      "include": "#expression"
    }
  ],
  "repository": {
    "expression": {
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#string"
        },
        {
          "include": "#asm-block"
        },
        {
          "include": "#effect-annotation"
        },
        {
          "include": "#list"
        },
        {
          "include": "#stray-close"
        },
        {
          "include": "#meta-constant"
        },
        {
          "include": "#rest"
        },
        {
          "include": "#type-annotation"
        },
        {
          "include": "#type"
        },
        {
          "include": "#number"
        },
        {
          "include": "#constant"
        }
      ]
    },
    "comment": {
      "match": "(;+).*$",
      "name": "comment.line.semicolon.sets",
      "captures": {
        "1": {
          "name": "punctuation.definition.comment.sets"
        }
      }
    },
    "string": {
      "begin": "\"",
      "end": "\"",
      "name": "string.quoted.double.sets",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.sets"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.sets"
        }
      }
    },
    "asm-block": {
      "begin": "\\{",
      "end": "\\}",
      "name": "meta.embedded.asm.sets",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.asm.begin.sets"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.asm.end.sets"
        }
      },
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#number"
        },
        {
          "match": "(?<![^\\s()\\[\\]{}\";])(nop|lit|c@|c!|@|!|drop|dup|swap|over|>r|r>|r@|rpick|\\+|-|\\*|/|mod|and|or|xor|=|<|branch|zbranch|call|ret|execute|trap)(?![^\\s()\\[\\]{}\";])",
          "name": "keyword.other.vm-op.sets"
        }
      ]
    },
    "effect-annotation": {
      "match": "(\\[)\\s*((?:(?:det|semidet|nondet|inline)\\s*)+)(\\])",
      "captures": {
        "1": {
          "name": "punctuation.definition.effect.begin.sets"
        },
        "2": {
          "patterns": [
            {
              "match": "\\b(det|semidet|nondet)\\b",
              "name": "storage.modifier.effect.sets"
            },
            {
              "match": "\\binline\\b",
              "name": "storage.modifier.inline.sets"
            }
          ]
        },
        "3": {
          "name": "punctuation.definition.effect.end.sets"
        }
      }
    },
    "stray-close": {
      "match": "[)\\]}]",
      "name": "invalid.illegal.stray-bracket.sets"
    },
    "meta-constant": {
      "match": "\\$(?:vm-sp|vm-rp|vm-ip|cell|mem|stack-size|ds-start|rs-start)(?![^\\s()\\[\\]{}\";])",
      "name": "constant.language.meta.sets"
    },
    "rest": {
      "match": "(?<![^\\s()\\[\\]{}\";])\\.\\.\\.(?![^\\s()\\[\\]{}\";])",
      "name": "keyword.operator.rest.sets"
    },
    "type-annotation": {
      "match": "(?<![^\\s()\\[\\]{}\";]):(?![^\\s()\\[\\]{}\";])",
      "name": "punctuation.separator.type.sets"
    },
    "type": {
      "match": "(?<![^\\s()\\[\\]{}\";])(int|byte|bool|void)(?![^\\s()\\[\\]{}\";])",
      "name": "support.type.sets"
    },
    "number": {
      "match": "(?<![^\\s()\\[\\]{}\";])-?[0-9]+(?![^\\s()\\[\\]{}\";])",
      "name": "constant.numeric.integer.sets"
    },
    "constant": {
      "match": "(?<![^\\s()\\[\\]{}\";])[A-Z][A-Z0-9_]*(?![^\\s()\\[\\]{}\";])",
      "name": "variable.other.constant.sets"
    },
    "params": {
      "begin": "\\G\\s*(\\()",
      "end": "\\)",
      "beginCaptures": {
        "1": {
          "name": "punctuation.section.list.begin.sets"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.list.end.sets"
        }
      },
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "begin": "(\\()\\s*([^\\s()\\[\\]{}\";]+)",
          "end": "\\)",
          "beginCaptures": {
            "1": {
              "name": "punctuation.section.list.begin.sets"
            },
            "2": {
              "name": "variable.parameter.sets"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.section.list.end.sets"
            }
          },
          "patterns": [
            {
              "include": "#expression"
            }
          ]
        },
        {
          "match": "[^\\s()\\[\\]{}\";]+",
          "name": "variable.parameter.sets"
        }
      ]
    },
    "bindings": {
      "begin": "\\G\\s*(\\()",
      "end": "\\)",
      "beginCaptures": {
        "1": {
          "name": "punctuation.section.list.begin.sets"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.list.end.sets"
        }
      },
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "begin": "(\\()\\s*([^\\s()\\[\\]{}\";]+)",
          "end": "\\)",
          "beginCaptures": {
            "1": {
              "name": "punctuation.section.list.begin.sets"
            },
            "2": {
              "name": "variable.other.local.sets"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.section.list.end.sets"
            }
          },
          "patterns": [
            {
              "include": "#expression"
            }
          ]
        }
      ]
    },
    "list": {
      "patterns": [
        {
          "begin": "(\\()\\s*(def)\\s+([^\\s()\\[\\]{}\";]+)",
          "end": "\\)",
          "beginCaptures": {
            "1": {
              "name": "punctuation.section.list.begin.sets"
            },
            "2": {
              "name": "storage.type.function.sets"
            },
            "3": {
              "name": "entity.name.function.sets"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.section.list.end.sets"
            }
          },
          "patterns": [
            {
              "include": "#params"
            },
            {
              "include": "#expression"
            }
          ],
          "name": "meta.function.sets"
        },
        {
          "begin": "(\\()\\s*(extern)\\s+([^\\s()\\[\\]{}\";]+)",
          "end": "\\)",
          "beginCaptures": {
            "1": {
              "name": "punctuation.section.list.begin.sets"
            },
            "2": {
              "name": "storage.type.extern.sets"
            },
            "3": {
              "name": "entity.name.function.extern.sets"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.section.list.end.sets"
            }
          },
          "patterns": [
            {
              "include": "#expression"
            }
          ]
        },
        {
          "begin": "(\\()\\s*(const)\\s+([^\\s()\\[\\]{}\";]+)",
          "end": "\\)",
          "beginCaptures": {
            "1": {
              "name": "punctuation.section.list.begin.sets"
            },
            "2": {
              "name": "storage.type.const.sets"
            },
            "3": {
              "name": "variable.other.constant.sets"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.section.list.end.sets"
            }
          },
          "patterns": [
            {
              "include": "#expression"
            }
          ]
        },
        {
          "begin": "(\\()\\s*(let|local)(?![^\\s()\\[\\]{}\";])",
          "end": "\\)",
          "beginCaptures": {
            "1": {
              "name": "punctuation.section.list.begin.sets"
            },
            "2": {
              "name": "keyword.control.sets"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.section.list.end.sets"
            }
          },
          "patterns": [
            {
              "include": "#bindings"
            },
            {
              "include": "#expression"
            }
          ]
        },
        {
          "begin": "(\\()\\s*(if|case|else|while|do)(?![^\\s()\\[\\]{}\";])",
          "end": "\\)",
          "beginCaptures": {
            "1": {
              "name": "punctuation.section.list.begin.sets"
            },
            "2": {
              "name": "keyword.control.sets"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.section.list.end.sets"
            }
          },
          "patterns": [
            {
              "include": "#expression"
            }
          ]
        },
        {
          "begin": "(\\()\\s*(\\$alloc)\\s+([^\\s()\\[\\]{}\";]+)",
          "end": "\\)",
          "beginCaptures": {
            "1": {
              "name": "punctuation.section.list.begin.sets"
            },
            "2": {
              "name": "keyword.other.directive.sets"
            },
            "3": {
              "name": "variable.other.constant.sets"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.section.list.end.sets"
            }
          },
          "patterns": [
            {
              "include": "#expression"
            }
          ]
        },
        {
          "begin": "(\\()\\s*(\\$op)\\s+([^\\s()\\[\\]{}\";]+)",
          "end": "\\)",
          "beginCaptures": {
            "1": {
              "name": "punctuation.section.list.begin.sets"
            },
            "2": {
              "name": "keyword.other.directive.sets"
            },
            "3": {
              "name": "keyword.other.vm-op.sets"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.section.list.end.sets"
            }
          },
          "patterns": [
            {
              "include": "#expression"
            }
          ]
        },
        {
          "begin": "(\\()\\s*(\\$section|\\$include)(?![^\\s()\\[\\]{}\";])",
          "end": "\\)",
          "beginCaptures": {
            "1": {
              "name": "punctuation.section.list.begin.sets"
            },
            "2": {
              "name": "keyword.other.directive.sets"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.section.list.end.sets"
            }
          },
          "patterns": [
            {
              "include": "#expression"
            }
          ]
        },
        {
          "begin": "(\\()\\s*(\\$(?:vm-sp|vm-rp|vm-ip|cell|mem|stack-size|ds-start|rs-start))(?![^\\s()\\[\\]{}\";])",
          "end": "\\)",
          "beginCaptures": {
            "1": {
              "name": "punctuation.section.list.begin.sets"
            },
            "2": {
              "name": "constant.language.meta.sets"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.section.list.end.sets"
            }
          },
          "patterns": [
            {
              "include": "#expression"
            }
          ]
        },
        {
          "begin": "(\\()\\s*(\\$[^\\s()\\[\\]{}\";]+)(?![^\\s()\\[\\]{}\";])",
          "end": "\\)",
          "beginCaptures": {
            "1": {
              "name": "punctuation.section.list.begin.sets"
            },
            "2": {
              "name": "invalid.illegal.unknown-meta.sets"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.section.list.end.sets"
            }
          },
          "patterns": [
            {
              "include": "#expression"
            }
          ]
        },
        {
          "begin": "(\\()\\s*(ptr|int|byte|bool|void)(?![^\\s()\\[\\]{}\";])",
          "end": "\\)",
          "beginCaptures": {
            "1": {
              "name": "punctuation.section.list.begin.sets"
            },
            "2": {
              "name": "support.type.sets"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.section.list.end.sets"
            }
          },
          "patterns": [
            {
              "include": "#expression"
            }
          ]
        },
        {
          "begin": "(\\()\\s*(c@|c!|@|!|addr|execute)(?![^\\s()\\[\\]{}\";])",
          "end": "\\)",
          "beginCaptures": {
            "1": {
              "name": "punctuation.section.list.begin.sets"
            },
            "2": {
              "name": "keyword.other.memory.sets"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.section.list.end.sets"
            }
          },
          "patterns": [
            {
              "include": "#expression"
            }
          ]
        },
        {
          "begin": "(\\()\\s*(emit|key|bye|assert-fail)(?![^\\s()\\[\\]{}\";])",
          "end": "\\)",
          "beginCaptures": {
            "1": {
              "name": "punctuation.section.list.begin.sets"
            },
            "2": {
              "name": "support.function.builtin.sets"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.section.list.end.sets"
            }
          },
          "patterns": [
            {
              "include": "#expression"
            }
          ]
        },
        {
          "begin": "(\\()\\s*(\\+|-|\\*|/|mod|and|or|xor|!=|<=|>=|=|<|>)(?![^\\s()\\[\\]{}\";])",
          "end": "\\)",
          "beginCaptures": {
            "1": {
              "name": "punctuation.section.list.begin.sets"
            },
            "2": {
              "name": "keyword.operator.sets"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.section.list.end.sets"
            }
          },
          "patterns": [
            {
              "include": "#expression"
            }
          ]
        },
        {
          "begin": "(\\()\\s*([^\\s()\\[\\]{}\";0-9:-][^\\s()\\[\\]{}\";]*)",
          "end": "\\)",
          "beginCaptures": {
            "1": {
              "name": "punctuation.section.list.begin.sets"
            },
            "2": {
              "name": "entity.name.function.call.sets"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.section.list.end.sets"
            }
          },
          "patterns": [
            {
              "include": "#expression"
            }
          ]
        },
        {
          "begin": "(\\()",
          "end": "\\)",
          "beginCaptures": {
            "1": {
              "name": "punctuation.section.list.begin.sets"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.section.list.end.sets"
            }
          },
          "patterns": [
            {
              "include": "#expression"
            }
          ]
        }
      ]
    }
  }
}
